PORT=5001
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Optional for live prototype testing:
# Enables /api/auth/demo to create/confirm the demo user and public.users profile
# on the local backend only. Never expose this key in frontend code.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_DEMO_EMAIL=demo@subscriptionguard.app
SUPABASE_DEMO_PASSWORD=<demo-password>
SUPABASE_DEMO_USER_NAME=Demo User
